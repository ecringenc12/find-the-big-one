#include <stdio.h>
#include <stdlib.h>
int main() {
	double al[5];
	int i;
	double tut=0;
	for(i=0;i<=4;i++)
	{
		printf("%d. sayi al-> ",i+1);
		scanf("%lf",&al[i]);
	}
	for(i=0;i<=4;i++)
	{
		tut=tut+al[i];
	}
	double ort=tut/5;
	printf("Ortalama-> %.2lf\n",ort);
	printf("Ortalamadan buyuk olan sayilar-> ");
	for(i=0;i<=4;i++)
	{
		if(ort<al[i])
		{
			printf("%.2lf ",al[i]);
		}
	}

	
	return 0;
}
